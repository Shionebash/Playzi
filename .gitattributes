* text=auto

# Force LF for shell scripts (must run on Linux)
scripts/linux/*.sh text eol=lf

# Windows scripts keep CRLF
scripts/windows/*.ps1 text eol=crlf

# Python and web files — normalize to LF
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.example text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
