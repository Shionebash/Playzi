APP_HOST=127.0.0.1
APP_PORT=8765
MEDIA_ROOT=~/ytlocal/media
DATA_DIR=~/ytlocal/data
STATE_FILE=~/ytlocal/data/state.json
DEFAULT_PLAYER=mpv
MPV_PATH=mpv
VLC_PATH=vlc
FFMPEG_PATH=ffmpeg
AUDIO_FORMAT=opus
YTDLP_SEARCH_LIMIT=12
PLAYBACK_QUALITY=best

# Optional: YouTube Music web client keys (defaults are scraped from music.youtube.com)
# YTMUSIC_API_KEY=
# YTMUSIC_CLIENT_VERSION=

# Optional: Playzi Cloudflare Workers Relay + Social Hub URL (e.g. https://playzi-hub.your-subdomain.workers.dev)
# SOCIAL_HUB_URL=

# Optional: Discord Rich Presence & Watch Party Invites (Application ID from Discord Developer Portal)
# DISCORD_ENABLED=true
# DISCORD_SHOW_MEDIA=true
# DISCORD_SHOW_PARTY=true
# DISCORD_CLIENT_ID=
