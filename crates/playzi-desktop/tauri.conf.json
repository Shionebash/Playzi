{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playzi",
  "version": "1.0.10",
  "identifier": "com.playzi.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Playzi",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "nsis/install-deps.ps1": "scripts/install-deps.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
